{
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Tests\\": "tests/"
        }
    },
    "require": {
        "ext-openssl": "*",
        "php": "^8.4",
        "php-di/php-di": "^7.1",
        "phpmailer/phpmailer": "^7.0",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "psr/http-server-middleware": "^1.0",
        "psr/http-server-handler": "^1.0",
        "nikic/fast-route": "^1.3",
        "twig/twig": "^3.23",
        "vlucas/phpdotenv": "^5.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "mikey179/vfsstream": "^1.6"
    },
    "scripts": {
        "build": "composer install --no-dev --optimize-autoloader",
        "test": "php -d xdebug.mode=coverage -r \"require 'vendor/bin/phpunit';\" -- --configuration phpunit.xml --do-not-cache-result --colors=always",
        "test:coverage": "php -d xdebug.mode=coverage -r \"require 'vendor/bin/phpunit';\" -- --configuration phpunit.xml --do-not-cache-result --coverage-html tests/coverage-report"
    }
}
